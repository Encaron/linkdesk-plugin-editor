{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "editor",
  "name": "编辑器",
  "version": "1.0.24",
  "icon": "resources/icon.svg",
  "description": "Monaco 代码编辑器——语法高亮、智能提示、Diff 对比",
  "author": "官方",
  "distribution": "builtin",
  "core": true,
  "entry": "src/index.tsx",
  "appearsIn": {
    "tabBar": true
  },
  "tabBehavior": {
    "singleton": false,
    "identityField": "filePath"
  },
  "contributes": {
    "i18n": {
      "en": "i18n/en.json"
    },
    "configuration": {
      "title": "编辑器",
      "properties": {
        "editor.autoSave": {
          "type": "string",
          "enum": [
            "off",
            "afterDelay",
            "onFocusChange"
          ],
          "default": "off",
          "description": "自动保存——off 手动保存 / afterDelay 1秒空闲后自动保存 / onFocusChange 切换标签页时自动保存",
          "group": "文件",
          "title": "自动保存",
          "enumDescriptions": {
            "off": "关",
            "afterDelay": "延迟自动",
            "onFocusChange": "切换标签页时"
          }
        },
        "editor.fontSize": {
          "type": "number",
          "default": 14,
          "uiHint": "fontSize",
          "description": "编辑器字号",
          "group": "字体",
          "title": "字号"
        },
        "editor.fontFamily": {
          "type": "string",
          "default": "Consolas",
          "uiHint": "fontFamily",
          "description": "编辑器字体",
          "group": "字体",
          "title": "字体系列"
        },
        "editor.fontWeight": {
          "type": "string",
          "enum": [
            "normal",
            "bold",
            "100",
            "200",
            "300",
            "400",
            "500",
            "600",
            "700",
            "800",
            "900"
          ],
          "default": "normal",
          "description": "编辑器字重",
          "group": "字体",
          "title": "字重",
          "enumDescriptions": {
            "normal": "正常",
            "bold": "粗体"
          }
        },
        "editor.lineHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "行高——0 表示自动计算",
          "group": "字体",
          "title": "行高"
        },
        "editor.tabSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Tab 缩进空格数",
          "group": "缩进",
          "title": "Tab 宽度"
        },
        "editor.insertSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Tab 键插入空格而非制表符",
          "group": "缩进",
          "title": "Tab 插入空格"
        },
        "editor.detectIndentation": {
          "type": "boolean",
          "default": true,
          "description": "自动检测文件缩进设置",
          "group": "缩进",
          "title": "自动检测缩进"
        },
        "editor.wordWrap": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "wordWrapColumn",
            "bounded"
          ],
          "default": "off",
          "description": "自动换行模式",
          "group": "显示",
          "title": "自动换行",
          "enumDescriptions": {
            "off": "关",
            "on": "开",
            "wordWrapColumn": "按列宽",
            "bounded": "边界换行"
          }
        },
        "editor.lineNumbers": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "relative",
            "interval"
          ],
          "default": "on",
          "description": "行号显示",
          "group": "显示",
          "title": "行号",
          "enumDescriptions": {
            "on": "显示",
            "off": "隐藏",
            "relative": "相对",
            "interval": "每 10 行"
          }
        },
        "editor.minimap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "显示代码缩略图",
          "group": "显示",
          "title": "代码缩略图"
        },
        "editor.renderWhitespace": {
          "type": "string",
          "enum": [
            "none",
            "boundary",
            "selection",
            "trailing",
            "all"
          ],
          "default": "selection",
          "description": "空白符渲染",
          "group": "显示",
          "title": "空白符",
          "enumDescriptions": {
            "none": "无",
            "boundary": "边界",
            "selection": "选区内",
            "trailing": "仅尾随",
            "all": "全部"
          }
        },
        "editor.smoothScrolling": {
          "type": "boolean",
          "default": true,
          "description": "平滑滚动",
          "group": "显示",
          "title": "平滑滚动"
        },
        "editor.cursorStyle": {
          "type": "string",
          "enum": [
            "line",
            "block",
            "underline",
            "line-thin",
            "block-outline",
            "underline-thin"
          ],
          "default": "line",
          "description": "光标样式",
          "group": "光标与滚动",
          "title": "光标样式",
          "enumDescriptions": {
            "line": "竖线",
            "block": "方块",
            "underline": "下划线",
            "line-thin": "细竖线",
            "block-outline": "方块轮廓",
            "underline-thin": "细下划线"
          }
        },
        "editor.cursorBlinking": {
          "type": "string",
          "enum": [
            "blink",
            "smooth",
            "phase",
            "expand",
            "solid"
          ],
          "default": "blink",
          "description": "光标闪烁方式",
          "group": "光标与滚动",
          "title": "光标闪烁",
          "enumDescriptions": {
            "blink": "闪烁",
            "smooth": "平滑",
            "phase": "相位",
            "expand": "扩张",
            "solid": "实心"
          }
        },
        "editor.mouseWheelZoom": {
          "type": "boolean",
          "default": true,
          "description": "Ctrl+滚轮缩放字号",
          "group": "光标与滚动",
          "title": "滚轮缩放"
        },
        "editor.autoClosingBrackets": {
          "type": "string",
          "enum": [
            "always",
            "languageDefined",
            "beforeWhitespace",
            "never"
          ],
          "default": "always",
          "description": "自动闭合括号",
          "group": "编辑",
          "title": "自动闭合括号",
          "enumDescriptions": {
            "always": "总是",
            "languageDefined": "语言定义",
            "beforeWhitespace": "空格前",
            "never": "从不"
          }
        },
        "editor.bracketPairColorization": {
          "type": "boolean",
          "default": true,
          "description": "括号对着色",
          "group": "编辑",
          "title": "括号着色"
        },
        "editor.guides.indentation": {
          "type": "boolean",
          "default": true,
          "description": "缩进引导线",
          "group": "编辑",
          "title": "缩进引导线"
        },
        "editor.linkedEditing": {
          "type": "boolean",
          "default": true,
          "description": "HTML/XML 标签同步重命名",
          "group": "编辑",
          "title": "标签联动改名"
        },
        "editor.occurrencesHighlight": {
          "type": "boolean",
          "default": true,
          "description": "选中单词所有出现处高亮",
          "group": "编辑",
          "title": "选中词高亮"
        },
        "editor.selectionHighlight": {
          "type": "boolean",
          "default": true,
          "description": "选区匹配文本高亮",
          "group": "编辑",
          "title": "选区高亮"
        },
        "editor.parameterHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "函数参数提示",
          "group": "智能提示",
          "title": "参数提示"
        },
        "editor.quickSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "快速建议",
          "group": "智能提示",
          "title": "快速建议"
        },
        "editor.suggest.showWords": {
          "type": "boolean",
          "default": true,
          "description": "补全列表显示单词建议",
          "group": "智能提示",
          "title": "单词补全"
        },
        "editor.suggest.showSnippets": {
          "type": "boolean",
          "default": true,
          "description": "补全列表显示代码片段",
          "group": "智能提示",
          "title": "片段补全"
        }
      }
    },
    "fileAssociations": [
      {
        "extension": "ts",
        "displayName": "TypeScript",
        "role": "text-fallback"
      },
      {
        "extension": "tsx",
        "displayName": "TypeScript React",
        "role": "text-fallback"
      },
      {
        "extension": "js",
        "displayName": "JavaScript",
        "role": "text-fallback"
      },
      {
        "extension": "jsx",
        "displayName": "JavaScript React",
        "role": "text-fallback"
      },
      {
        "extension": "mjs",
